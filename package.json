{
  "name": "pax-mediterranea",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run src/test/integration",
    "test:i18n": "vitest run src/i18n",
    "test:e2e": "playwright test",
    "test:e2e:i18n": "playwright test e2e/i18n.spec.ts",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:ai": "node --import tsx scripts/run-ai-simulations.ts",
    "validate:maps": "node --import tsx scripts/validate-content.ts maps",
    "validate:scenarios": "node --import tsx scripts/validate-content.ts scenarios",
    "validate:i18n": "node --import tsx scripts/validate-i18n.ts",
    "check": "npm run format && npm run lint && npm run typecheck && npm run test:coverage && npm run validate:maps && npm run validate:scenarios && npm run validate:i18n && npm run build",
    "ci": "npm run check && npm run test:integration && npm run test:e2e"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "i18next": "^25.6.3",
    "i18next-browser-languagedetector": "^8.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^16.3.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.0.15",
    "axe-core": "^4.11.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.57.0",
    "prettier": "^3.7.4",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.1",
    "vite": "^7.2.6",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.0.15"
  }
}
